# Required. Your Postgres connection string.
#
# From a Supabase project: Project Settings -> Database -> Connection string.
# Use the "Transaction" pooler string (port 6543) if deploying to Vercel/serverless
# so you don't exhaust Postgres connections across function invocations; the
# direct connection (port 5432) is fine for local development.
#
# Local Postgres example: postgres://postgres:postgres@localhost:5432/chillchai
DATABASE_URL=

# Copy this file to .env.local and fill in your Gemini API key to enable
# live "Generate with Gemini" buttons throughout the app.
# Get a key from https://aistudio.google.com/apikey
#
# Without this, every generator still works: it assembles the exact prompt
# and gives you a "Copy prompt" button to paste into Gemini/Claude/ChatGPT
# yourself.
GEMINI_API_KEY=

# Optional — defaults to gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash

# Set this to password-protect the app (required once you deploy it to Vercel --
# without it, anyone with the URL can see your brand/content data).
# Leave empty for open access during local development.
APP_PASSWORD=

# Optional — a separate secret for signing the login session cookie.
# Falls back to APP_PASSWORD if unset. Generate one with: openssl rand -base64 32
SESSION_SECRET=
